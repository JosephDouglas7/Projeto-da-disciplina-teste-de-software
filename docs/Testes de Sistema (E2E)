# Configura o Matplotlib para rodar em modo sem interface gráfica (evita crash em servidores/CI)
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# ==========================================
# MÓDULO DE CÓDIGO BASE (Funções a serem testadas)
# ==========================================

def gerar_audio(texto, idioma="pt"):
    if not isinstance(texto, str) or not texto.strip():
        raise ValueError("O texto fornecido para áudio é inválido ou vazio.")
    inicio = time.time()
    from gtts import gTTS
    tts = gTTS(text=texto, lang=idioma)
    arquivo = "saida.mp3"
    tts.save(arquivo)
    fim = time.time()
    return arquivo, (fim - inicio)

def gerar_grafico_letras(texto):
    if not isinstance(texto, str) or not texto.strip():
        raise ValueError("O texto fornecido para o gráfico é inválido ou vazio.")
    inicio = time.time()
    
    letras = [c.lower() for c in texto if c.isalpha()]
    contagem = Counter(letras)

    plt.figure(figsize=(10, 6))
    plt.bar(list(contagem.keys()), list(contagem.values()), color='lightgreen')
    plt.title("Frequência de Letras")
    plt.xlabel("Letras")
    plt.ylabel("Quantidade")
    plt.tight_layout()
    plt.savefig("grafico.png")
    plt.close()
    
    fim = time.time()
    return "grafico.png", (fim - inicio)

def executar_busca_web(termo_busca="Python"):
    options = webdriver.ChromeOptions()
    options.add_argument("--headless=new") # Modo headless otimizado
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    
    driver = webdriver.Chrome(options=options)
    try:
        inicio = time.time()
        driver.get("https://www.google.com")
        
        # Localiza a barra de pesquisa
        elemento = WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.NAME, "q"))
        )
        elemento.send_keys(termo_busca)
        elemento.submit()
        
        # Validação visual/UI básica
        WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.ID, "search"))
        )
        fim = time.time()
        return True, (fim - inicio), driver
    except Exception as e:
        print(f"Erro na execução web: {e}")
        return False, 0, driver
    finally:
        driver.quit()


