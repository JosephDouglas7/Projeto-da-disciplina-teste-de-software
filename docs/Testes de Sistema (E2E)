@pytest.mark.unit
def test_gerar_audio_unidade_sucesso():
    texto = "Teste unitario de audio."
    arquivo, tempo = gerar_audio(texto)
    assert os.path.exists(arquivo) is True
    assert tempo > 0
    if os.path.exists(arquivo):
        os.remove(arquivo)

@pytest.mark.unit
def test_gerar_audio_unidade_erro():
    with pytest.raises(ValueError, match="O texto fornecido para áudio é inválido"):
        gerar_audio("")

@pytest.mark.integration
def test_integracao_processamento_texto():
    texto = "Teste de Integração 123!"
    arquivo_grafico, tempo = gerar_grafico_letras(texto)
    assert os.path.exists(arquivo_grafico) is True
    assert tempo >= 0
    if os.path.exists(arquivo_grafico):
        os.remove(arquivo_grafico)

@pytest.mark.performance
def test_performance_geracao_midia():
    texto = "Performance de áudio e processamento de dados textuais."
    _, tempo_audio = gerar_audio(texto)
    assert tempo_audio < 10.0, f"Tempo de áudio excedeu o limite: {tempo_audio}s"
    if os.path.exists("saida.mp3"):
        os.remove("saida.mp3")

@pytest.mark.performance
def test_performance_resposta_web():
    sucesso, tempo_resposta, _ = executar_busca_web("Automação")
    assert sucesso is True
    assert tempo_resposta < 6.0, f"Tempo de resposta web muito alto: {tempo_resposta}s"

@pytest.mark.e2e
def test_e2e_caminho_feliz():
    texto = "Caminho feliz completo do sistema."
    
    arq_audio, _ = gerar_audio(texto)
    arq_grafico, _ = gerar_grafico_letras(texto)
    
    assert os.path.exists(arq_audio)
    assert os.path.exists(arq_grafico)

    sucesso, _, _ = executar_busca_web("Selenium Python")
    assert sucesso is True

    if os.path.exists(arq_audio): os.remove(arq_audio)
    if os.path.exists(arq_grafico): os.remove(arq_grafico)

@pytest.mark.e2e
def test_e2e_caminho_excecao():
    with pytest.raises(ValueError):
        gerar_grafico_letras("")

    options = webdriver.ChromeOptions()
    options.add_argument("--headless=new")
    driver = webdriver.Chrome(options=options)
    try:
        driver.get("https://www.google.com")
        elemento = WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.NAME, "q"))
        )
        assert elemento.is_displayed()
    finally:
        driver.quit()

@pytest.mark.compatibility
def test_compatibilidade_responsiva_ui():
    options = webdriver.ChromeOptions()
    options.add_argument("--headless=new")
    driver = webdriver.Chrome(options=options)
    
    resolucoes = [(1920, 1080), (1366, 768), (375, 812)]
    
    try:
        for largura, altura in resolucoes:
            driver.set_window_size(largura, altura)
            driver.get("https://www.google.com")
            
            elemento = WebDriverWait(driver, 10).until(
                EC.visibility_of_element_located((By.NAME, "q"))
            )
            assert elemento.is_displayed(), f"Elemento oculto na resolução {largura}x{altura}"
    finally:
        driver.quit()
